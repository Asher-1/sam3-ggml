+// Fast path for CONV_TRANSPOSE_2D with a 2x2 kernel and stride 2 (SAM3-style
+// upsampling). The four output phases (dy,dx) are independent 1x1
+// convolutions of the input, so the whole op reduces to a single GEMM with
+// K = 4*Cout (one phase block per output channel) plus an interleave
+// write-back. This replaces the generic transposed-conv shader, which walks
+// every output pixel and discards 3 of 4 stride-misaligned taps.
+static void ggml_vk_conv_transpose_2d_fast(ggml_backend_vk_context * ctx, vk_context & subctx,
+                                           const ggml_tensor * src0, const ggml_tensor * src1,
+                                           ggml_tensor * dst) {
+    const bool kernel_f16 = src0->type == GGML_TYPE_F16;
+
+    const uint32_t W    = (uint32_t)src1->ne[0];
+    const uint32_t H    = (uint32_t)src1->ne[1];
+    const uint32_t Cin  = (uint32_t)src1->ne[2];
+    const uint32_t Cout = (uint32_t)src0->ne[2];
+    const uint32_t WH   = W * H;
+    const uint32_t K    = 4 * Cout;
+
+    // temp buffers: reordered kernel [Cin, 4*Cout] + dense phase output [W, H, 4*Cout]
+    const size_t size_k  = (size_t)4 * Cout * Cin * (kernel_f16 ? sizeof(ggml_fp16_t) : sizeof(float));
+    const size_t size_ph = (size_t)4 * Cout * WH * sizeof(float);
+    if (ctx->prealloc_size_x < size_k) {
+        ctx->prealloc_size_x = size_k;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    if (ctx->prealloc_size_y < size_ph) {
+        ctx->prealloc_size_y = size_ph;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    if (ctx->prealloc_x_need_sync || ctx->prealloc_y_need_sync) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+
+    vk_subbuffer buf_k  = ggml_vk_subbuffer(ctx, ctx->prealloc_x);
+    vk_subbuffer buf_ph = ggml_vk_subbuffer(ctx, ctx->prealloc_y);
+    vk_subbuffer buf_w  = ggml_vk_tensor_subbuffer(ctx, src0, true);
+    vk_subbuffer buf_in = ggml_vk_tensor_subbuffer(ctx, src1, true);
+    vk_subbuffer buf_out = ggml_vk_tensor_subbuffer(ctx, dst, true);
+
+    // 1. reorder the strided kernel into the dense [Cin, 4*Cout] layout
+    vk_pipeline reorder_pipeline = kernel_f16 ? ctx->device->pipeline_conv_transpose_2d_reorder_f16
+                                              : ctx->device->pipeline_conv_transpose_2d_reorder_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, reorder_pipeline, 1);
+    const uint32_t reorder_total = 4 * Cout * Cin;
+    ggml_vk_dispatch_pipeline(ctx, subctx, reorder_pipeline, { buf_w, buf_k },
+        vk_op_conv_transpose_2d_reorder_push_constants{ Cout, Cin, reorder_total },
+        { reorder_total, 1, 1 });
+    // the GEMM reads the reordered kernel: order the two dispatches
+    ggml_vk_sync_buffers(ctx, subctx);
+
+    // 2. one 1x1 conv GEMM: [K, Cin] @ [Cin, WH] = [K, WH]
+    const vk_conv_shapes shape = ggml_vk_conv_select_shape(ctx, K, WH);
+    const uint32_t BS_K   = vk_conv_block_sizes[shape].K;
+    const uint32_t BS_CRS = vk_conv_block_sizes[shape].CRS;
+    const uint32_t BS_NPQ = vk_conv_block_sizes[shape].NPQ;
