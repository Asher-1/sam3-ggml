+template <typename T, typename D>
+static __global__ void rope_custom_freqs(
+        const T * x, D * dst, const float * freqs,
+        int64_t ne00, int64_t ne01, int64_t ne02,
+        size_t s01, size_t s02, size_t s03,
+        size_t d01, size_t d02, size_t d03,
+        int64_t n_pairs) {
+    const int64_t pair = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (pair >= n_pairs) {
+        return;
+    }
+
+    const int64_t half = ne00 / 2;
+    const int64_t d = pair % half;
+    const int64_t row = pair / half;
+    const int64_t i1 = row % ne01;
+    const int64_t i2 = (row / ne01) % ne02;
+    const int64_t i3 = row / (ne01 * ne02);
+    const int64_t src = i1 * s01 + i2 * s02 + i3 * s03 + 2 * d;
+    const int64_t out = i1 * d01 + i2 * d02 + i3 * d03 + 2 * d;
+    const int64_t f = i1 * ne00 + 2 * d;
+
+    const float re = (float) x[src + 0];
+    const float im = (float) x[src + 1];
+    const float cs = freqs[f + 0];
+    const float sn = freqs[f + 1];
+    dst[out + 0] = (D) (re * cs - im * sn);
+    dst[out + 1] = (D) (re * sn + im * cs);
+}
