+    // knl_idx = K_idx * nb02 + Cin_idx_a * nb03 (KW = KH = 1), i.e. the dense
+    // reordered [K, Cin] matrix is read with strides (Cin, 1). The plain conv2d
+    // variants swap the two terms and read the buffer completely out of bounds.
+    if (kernel_f16) {
+        pipelines = &ctx->device->pipeline_conv_transpose_2d_f16_f32[shape];
+    } else {
+        pipelines = &ctx->device->pipeline_conv_transpose_2d_f32[shape];
+    }
+    vk_pipeline conv_pipeline = nullptr;
