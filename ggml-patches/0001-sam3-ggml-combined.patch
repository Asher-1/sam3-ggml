+// Tiled fast path for unit-dilation 2D im2col (the common vision-tower case).
+// The scalar kernel above gathers every source tap with only s0-wide
+// contiguous segments (3-wide for 3x3 kernels), so read bandwidth collapses;
+// this variant streams both sides near full bandwidth:
+//   - phase 1: cooperatively load the input tile [KH][IC_B][in_w] (with halo)
+//     into shared memory using fully coalesced reads, zeros pre-filled for
+//     out-of-bounds taps;
+//   - phase 2: one thread per output element, written as contiguous spans of
+//     the [N, OH, OW, IC*KH*KW] layout, reading taps from shared memory.
+// Pure data movement - output is bit-identical to the scalar kernel.
+template <typename T>
+static __global__ void im2col_tiled_kernel(
+        const float * x, T * dst,
+        int64_t IC, int64_t IW, int64_t IH, int64_t OW, int64_t OH,
+        int64_t KH, int64_t KW, int64_t KH_KW, int64_t IC_KH_KW,
+        int s0, int s1, int p0, int p1,
+        int64_t IC_B, int64_t TW, int64_t in_w,
+        int64_t ic_blocks, int64_t tiles_x, int64_t rows) {
+    extern __shared__ float smem[];  // [KH][IC_B][in_w]
+
+    // Per-tile element counts are bounded by the smem guard below (<= 48 KB /
+    // 4 B and <= 32*32*196), so 32-bit indices are safe and much cheaper than
+    // 64-bit division on GPU.
+    const int c_total = (int)(IC_B * in_w);
+    const int cw      = (int)in_w;
+    const int out_span = (int)(IC_B * KH_KW);
+
+    for (int64_t iz = blockIdx.z; iz < rows; iz += MAX_GRIDDIM_Z) {
+        const int oh = (int)(iz % OH);
+        const int n  = (int)(iz / OH);
+        for (int64_t iy = blockIdx.y; iy < tiles_x; iy += MAX_GRIDDIM_Y) {
+            const int ow0 = (int)(iy * TW);
+            const int iw0 = ow0 * s0 - p0;
+          for (int64_t ix = blockIdx.x; ix < ic_blocks; ix += MAX_GRIDDIM_Y) {
+            const int ic0 = (int)(ix * IC_B);
+
+            // phase 1: load [KH][IC_B][in_w], zeros for out-of-bounds taps
+            const int total_in = (int)KH * c_total;
+            for (int t = threadIdx.x; t < total_in; t += blockDim.x) {
+                const int kh = t / c_total;
+                const int r  = t - kh * c_total;
+                const int c  = r / cw;
+                const int j  = r - c * cw;
+                const int ic = ic0 + c;
+                const int ih = oh * s1 + kh - p1;
+                const int iw = iw0 + j;
