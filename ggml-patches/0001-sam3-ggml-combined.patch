+    const uint32_t interleave_total = 4 * WH * Cout;
+    ggml_vk_dispatch_pipeline(ctx, subctx, interleave_pipeline, { buf_ph, buf_out },
+        vk_op_conv_transpose_2d_interleave_push_constants{ W, H, Cout, interleave_total },
+        { interleave_total, 1, 1 });
