+                    v = x[((int64_t)n * IC + ic) * IH * IW + (int64_t)ih * IW + iw];
+                }
+                smem[(kh * c_total) + r] = v;  // == smem[kh*IC_B*in_w + c*in_w + j]
+            }
+            __syncthreads();
+
+            // phase 2: one thread per output element, contiguous dst spans
+            const int total_out = (int)TW * out_span;
+            const int64_t row_base = ((int64_t)n * OH + oh) * OW * IC_KH_KW;
+            for (int t = threadIdx.x; t < total_out; t += blockDim.x) {
+                const int owl   = t / out_span;
+                const int r     = t - owl * out_span;
+                const int c     = r / (int)KH_KW;
+                const int ikhkw = r - c * (int)KH_KW;
+                const int ic    = ic0 + c;
+                if (ic < (int)IC && ow0 + owl < (int)OW) {
+                    const int kh  = ikhkw / (int)KW;
+                    const int ikw = ikhkw - kh * (int)KW;
+                    const float v = smem[kh * c_total + c * cw + owl * s0 + ikw];
+                    dst[row_base + (int64_t)(ow0 + owl) * IC_KH_KW + ic * KH_KW + ikhkw] = (T) v;
+                }
+            }
+            __syncthreads();
+          }
+        }
+    }
+}
+
+template <typename T>
+static bool im2col_tiled_try(const float * x, T* dst,
+    int64_t IW, int64_t IH, int64_t OW, int64_t OH, int64_t KW, int64_t KH, int64_t IC,
+    int64_t N, int s0,int s1,int p0,int p1,int d0,int d1, cudaStream_t stream) {
+    if (d0 != 1 || d1 != 1) {
+        return false;
+    }
+    int64_t TW = 32;
+    int64_t IC_B = (CUDA_IM2COL_BLOCK_SIZE + KH*KW - 1) / (KH*KW);
+    if (IC_B < 1)  IC_B = 1;
+    if (IC_B > 32) IC_B = 32;
+    int64_t in_w = (TW - 1) * s0 + KW;
+    while (TW > 1 && IC_B * KH * in_w * sizeof(float) > 48*1024) {
+        TW /= 2;
+        in_w = (TW - 1) * s0 + KW;
+    }
+    const size_t smem_size = (size_t)(IC_B * KH * in_w) * sizeof(float);
+    if (smem_size > 48*1024) {
+        return false;
+    }
+    const int64_t rows      = N * OH;
+    const int64_t ic_blocks = (IC + IC_B - 1) / IC_B;
+    const int64_t tiles_x   = (OW + TW - 1) / TW;
+    dim3 block_nums(MIN(ic_blocks, MAX_GRIDDIM_Y), MIN(tiles_x, MAX_GRIDDIM_Y), MIN(rows, MAX_GRIDDIM_Z));
+    im2col_tiled_kernel<<<block_nums, CUDA_IM2COL_BLOCK_SIZE, smem_size, stream>>>(
+        x, dst, IC, IW, IH, OW, OH, KH, KW, KW*KH, IC*KH*KW,
+        s0, s1, p0, p1, IC_B, TW, in_w, ic_blocks, tiles_x, rows);
+    return true;
+}
